{
  "functions": {
    "api/**/*.js": {
      "memory": 1024,
      "maxDuration": 10
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://www.mercadopago.com https://sdk.mercadopago.com https://www.googletagmanager.com https://www.google-analytics.com https://connect.facebook.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https: blob:; connect-src 'self' https://lhjzxwthuqpqsvqpvsxw.supabase.co https://api.telegram.org https://api.brevo.com https://api.systeme.io https://api.mercadopago.com https://www.google-analytics.com; frame-src 'self' https://www.mercadopago.com https://www.youtube.com; object-src 'none'; base-uri 'self';"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Credentials", "value": "true" },
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET,OPTIONS,POST,PUT,DELETE" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization, X-Requested-With" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/payments/mercadopago/create-preference",
      "destination": "/api/mercadopago-create"
    },
    {
      "source": "/api/payments/mercadopago/webhook",
      "destination": "/api/mercadopago-webhook"
    },
    {
      "source": "/api/payments/paypal/create-order",
      "destination": "/api/paypal-create"
    },
    {
      "source": "/api/payments/paypal/capture-payment",
      "destination": "/api/paypal-capture-order"
    },
    {
      "source": "/api/email/send-course-email",
      "destination": "/api/send-course-email"
    },
    {
      "source": "/((?!sitemap\\.xml|robots\\.txt|googleabf40f54cd54f548\\.html|manifest\\.json|logo\\.svg|icon-.*\\.png).*)",
      "destination": "/"
    }
  ]
}
