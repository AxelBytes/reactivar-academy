# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Brevo API Key (para emails)
BREVO_API_KEY=your_brevo_api_key

# Supabase Service Role (solo para backend/API)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# systeme.io
SYSTEME_API_KEY=your_systeme_api_key
SYSTEME_TAG_ID=your_tag_id

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# Admin Credentials (solo backend - NUNCA exponer en frontend)
ADMIN_EMAIL=admin@tudominio.com
ADMIN_PASSWORD=tu_password_seguro
ADMIN_NAME=Nombre del Admin

# Suscripciones - Buscador de Reglamento (Google Apps Script)
VITE_GAS_URL=https://script.google.com/macros/s/TU_SCRIPT_ID/exec
VITE_ADMIN_SECRET=tu_admin_secret_aqui
